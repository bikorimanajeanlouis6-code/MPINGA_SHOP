@using Application.DTOs
@using Application.Services.ProductCategoryServices
@inject IProductCategoryService ProductCategoryService
@inject ISnackbar Snackbar
@inject ILogger<AddProductCategory> Logger

<MudDialog>
    <TitleContent>Add Product Category</TitleContent>
    <DialogContent>
        <EditForm Model="@productCategory" OnValidSubmit="SaveProductCategoryAsync">
            <DataAnnotationsValidator />
            <MudTextField @bind-Value="productCategory.ProductCategoryName"
                          For="@(() => productCategory.ProductCategoryName)"
                          Label="Product Category Name"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          AutoFocus="true" />

            <MudTextField @bind-Value="productCategory.ProductCategoryDescription"
                          For="@(() => productCategory.ProductCategoryDescription)"
                          Label="Product Category Description"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Lines="3" />

            <div class="d-flex justify-end mt-4">
                <MudButton Color="Color.Primary"
                           ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Save">
                    Save Category
                </MudButton>
            </div>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel"
                   Variant="Variant.Text">
            Cancel
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private readonly AddProductCategoryDTO productCategory = new();

    private void Cancel() => MudDialog.Close(DialogResult.Cancel());

    private async Task SaveProductCategoryAsync()
    {
        productCategory.DateAdded = DateTime.Now;
        productCategory.Status = "Active";

        try
        {
            await ProductCategoryService.AddProductCategoryAsync(productCategory);
            Snackbar.Add("Product category added successfully.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to add product category.");
            Snackbar.Add("Could not add the product category.", Severity.Error);
        }
    }
}
