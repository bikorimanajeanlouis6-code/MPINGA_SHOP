@page "/SalesReport"
@using Application.DTOs
@using Application.Services.SalesServices
@using System.Globalization
@using Web.Reports
@rendermode InteractiveServer
@inject ISalesService SalesService
@inject ILogger<SalesReport> Logger
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.h6">Sales Report</MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Print"
                       data-pdf-print="true"
                       OnClick="PrintReportAsync"
                       Disabled="@(!CanGenerateReport)">
                Print
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Download"
                       OnClick="DownloadReportAsync"
                       Disabled="@(!CanGenerateReport)">
                Download PDF
            </MudButton>
            <MudButton Variant="Variant.Text" Href="/Sales" StartIcon="@Icons.Material.Filled.ArrowBack">
                Sales
            </MudButton>
        </MudStack>

        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6" md="4">
                <MudSelect T="string"
                           @bind-Value="_selectedPeriod"
                           Label="Report period"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense">
                    <MudSelectItem T="string" Value="@DayPeriod">Day</MudSelectItem>
                    <MudSelectItem T="string" Value="@WeekPeriod">Week</MudSelectItem>
                    <MudSelectItem T="string" Value="@MonthPeriod">Month</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudDatePicker @bind-Date="_reportDate"
                               Label="Select date"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               DateFormat="dd MMM yyyy" />
            </MudItem>
            <MudItem xs="12" md="4" Class="d-flex align-center">
                <MudText Color="Color.Secondary">Showing @PeriodDescription</MudText>
            </MudItem>
        </MudGrid>

        @if (isLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (loadError)
        {
            <MudAlert Severity="Severity.Error">
                Sales report could not be loaded.
                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="LoadSalesAsync">Retry</MudButton>
            </MudAlert>
        }
        else
        {
            <MudPaper Elevation="0" Class="pa-3" Style="border: 1px solid var(--mud-palette-lines-default);">
                <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="4">
                    <MudText Typo="Typo.subtitle1"><strong>@FilteredSales.Count</strong> sales</MudText>
                    <MudText Typo="Typo.subtitle1">Consumed: <strong>@FormatMoney(TotalConsumed)</strong></MudText>
                    <MudText Typo="Typo.subtitle1">Paid: <strong>@FormatMoney(TotalPaid)</strong></MudText>
                    <MudText Typo="Typo.subtitle1">Balance: <strong>@FormatMoney(TotalBalance)</strong></MudText>
                </MudStack>
            </MudPaper>

            <MudDataGrid T="GetSalesDTO"
                         Items="@FilteredSales"
                         SortMode="SortMode.Multiple"
                         Dense="true"
                         Hover="true"
                         Elevation="1">
                <Columns>
                    <TemplateColumn Title="Reference">
                        <CellTemplate>@EntityReferenceFormatter.Format(EntityReferenceType.Sale, context.Item.Id)</CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="sale => sale.CustomerName" Title="Customer" />
                    <TemplateColumn Title="Total Consumed">
                        <CellTemplate>@FormatMoney(SalesReportPdfBuilder.ParseAmount(context.Item.TotalConsumed))</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Total Paid">
                        <CellTemplate>@FormatMoney(SalesReportPdfBuilder.ParseAmount(context.Item.TotalPaid))</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Balance">
                        <CellTemplate>@FormatMoney(SalesReportPdfBuilder.ParseAmount(context.Item.Balance))</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Sale Date">
                        <CellTemplate>@context.Item.SaleDate.ToString("dd MMM yyyy", CultureInfo.CurrentCulture)</CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="sale => sale.UserAdded" Title="User Added" />
                </Columns>
                <NoRecordsContent>
                    <MudText Class="pa-4" Color="Color.Secondary">No sales were recorded during this period.</MudText>
                </NoRecordsContent>
                <PagerContent>
                    <MudDataGridPager T="GetSalesDTO" />
                </PagerContent>
            </MudDataGrid>
        }
    </MudStack>
</MudContainer>

@code {
    private const string DayPeriod = "Day";
    private const string WeekPeriod = "Week";
    private const string MonthPeriod = "Month";

    private string _selectedPeriod = DayPeriod;
    private DateTime? _reportDate = DateTime.Today;
    private List<GetSalesDTO> sales = new();
    private bool isLoading;
    private bool loadError;

    private bool CanGenerateReport => !isLoading && !loadError && _reportDate.HasValue;

    private (DateTime Start, DateTime End) SelectedDateRange
    {
        get
        {
            var selectedDate = (_reportDate ?? DateTime.Today).Date;
            return _selectedPeriod switch
            {
                WeekPeriod => GetWeekRange(selectedDate),
                MonthPeriod => (new DateTime(selectedDate.Year, selectedDate.Month, 1),
                    new DateTime(selectedDate.Year, selectedDate.Month, 1).AddMonths(1)),
                _ => (selectedDate, selectedDate.AddDays(1))
            };
        }
    }

    private List<GetSalesDTO> FilteredSales
    {
        get
        {
            var range = SelectedDateRange;
            return sales
                .Where(sale => sale.SaleDate >= range.Start && sale.SaleDate < range.End)
                .OrderByDescending(sale => sale.SaleDate)
                .ToList();
        }
    }

    private decimal TotalConsumed => FilteredSales.Sum(sale => SalesReportPdfBuilder.ParseAmount(sale.TotalConsumed));
    private decimal TotalPaid => FilteredSales.Sum(sale => SalesReportPdfBuilder.ParseAmount(sale.TotalPaid));
    private decimal TotalBalance => FilteredSales.Sum(sale => SalesReportPdfBuilder.ParseAmount(sale.Balance));

    private string PeriodDescription
    {
        get
        {
            if (!_reportDate.HasValue)
                return "select a date";

            var (start, end) = SelectedDateRange;
            var lastDay = end.AddDays(-1);
            return start.Date == lastDay.Date
                ? start.ToString("dd MMM yyyy", CultureInfo.CurrentCulture)
                : $"{start.ToString("dd MMM yyyy", CultureInfo.CurrentCulture)} to {lastDay.ToString("dd MMM yyyy", CultureInfo.CurrentCulture)}";
        }
    }

    protected override Task OnInitializedAsync() => LoadSalesAsync();

    private static (DateTime Start, DateTime End) GetWeekRange(DateTime date)
    {
        var daysSinceMonday = ((int)date.DayOfWeek + 6) % 7;
        var start = date.AddDays(-daysSinceMonday);
        return (start, start.AddDays(7));
    }

    private static string FormatMoney(decimal amount) =>
        MoneyFormatter.Format(amount);

    private async Task LoadSalesAsync()
    {
        isLoading = true;
        loadError = false;

        try
        {
            sales = await SalesService.GetAllSalesAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load sales for report.");
            loadError = true;
            Snackbar.Add("Could not load the sales report.", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task PrintReportAsync()
    {
        if (!CanGenerateReport)
            return;

        try
        {
            await JS.InvokeVoidAsync(
                "customerReportDownloads.printPdf",
                Convert.ToBase64String(CreateReportPdf()));
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not print the sales report PDF.");
            Snackbar.Add("Could not open the print dialog.", Severity.Error);
        }
    }

    private async Task DownloadReportAsync()
    {
        if (!CanGenerateReport)
            return;

        try
        {
            var fileName = $"sales-report-{_selectedPeriod.ToLowerInvariant()}-{_reportDate!.Value:yyyyMMdd}.pdf";
            await JS.InvokeVoidAsync(
                "customerReportDownloads.downloadPdf",
                Convert.ToBase64String(CreateReportPdf()),
                fileName);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not generate the sales report PDF.");
            Snackbar.Add("Could not download the sales report.", Severity.Error);
        }
    }

    private byte[] CreateReportPdf() => SalesReportPdfBuilder.CreatePdf(
        FilteredSales,
        PeriodDescription,
        TotalConsumed,
        TotalPaid,
        TotalBalance);
}
