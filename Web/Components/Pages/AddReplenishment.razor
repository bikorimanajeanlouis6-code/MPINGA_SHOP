@using System.Globalization
@using Application.DTOs
@using Application.Services.AccountServices
@using Application.Services.PaymentMethordServices
@using Application.Services.ProductServices
@using Application.Services.ReplenishmentServices
@using Web.Formatting
@inject IAccountService AccountService
@inject IPaymentMethordService PaymentMethodService
@inject IProductService ProductService
@inject IReplenishmentService ReplenishmentService
@inject ISnackbar Snackbar
@inject ILogger<AddReplenishment> Logger

<MudDialog Class="add-dialog">
    <TitleContent>Add Replenishment</TitleContent>
    <DialogContent>
        <EditForm Model="@replenishment" OnValidSubmit="SaveReplenishmentAsync">
            <DataAnnotationsValidator />
            <MudGrid>
                <MudItem xs="12">
                    <MudTextField @bind-Value="replenishment.ReplenishmentName"
                                  For="@(() => replenishment.ReplenishmentName)"
                                  Label="Name"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  AutoFocus="true"
                                  Class="dialog-input" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="replenishment.SupplierName"
                                  For="@(() => replenishment.SupplierName)"
                                  Label="Supplier Name"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Class="dialog-input" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="replenishment.SupplierPhone"
                                  For="@(() => replenishment.SupplierPhone)"
                                  Label="Supplier Phone"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  InputType="InputType.Telephone"
                                  Class="dialog-input" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="int"
                                     @bind-Value="replenishment.QuantityReplenished"
                                     For="@(() => replenishment.QuantityReplenished)"
                                     Label="Quantity"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Min="1"
                                     Class="dialog-input" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Value="@SelectedProductUnit"
                                  Label="Unit"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  ReadOnly="true"
                                  HelperText="Unit is set by the selected product."
                                  Class="dialog-input" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="replenishment.SellingPrice"
                                  For="@(() => replenishment.SellingPrice)"
                                  Label="Selling Price (RWF)"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  InputType="InputType.Number"
                                  Immediate="true"
                                  Class="dialog-input" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="replenishment.PurchasePrice"
                                  For="@(() => replenishment.PurchasePrice)"
                                  Label="Purchase Price per unit (RWF)"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  InputType="InputType.Number"
                                  Immediate="true"
                                  Class="dialog-input" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Value="@CalculatedTotal.ToString("0.##", CultureInfo.InvariantCulture)"
                                  Label="Calculated Amount (RWF)"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  ReadOnly="true"
                                  Class="dialog-input" />
                </MudItem>
                <MudItem xs="12">
                    <MudNumericField T="decimal"
                                     @bind-Value="_paidNow"
                                     Label="Amount paid to supplier now (RWF)"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Min="0"
                                     Max="@CalculatedTotal"
                                     Disabled="@isSaving"
                                     HelperText="Leave at zero if the supplier will be paid later." />
                </MudItem>
                @if (_paidNow > 0)
                {
                    <MudItem xs="12" sm="6">
                        <MudSelect T="int?"
                                   @bind-Value="_accountId"
                                   Label="Pay from account"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Required="true"
                                   RequiredError="Select the account used for this payment."
                                   Disabled="@(accounts.Count == 0 || paymentOptionsError || isSaving)"
                                   Class="dialog-input">
                            @foreach (var account in accounts)
                            {
                                <MudSelectItem T="int?" Value="@((int?)account.Id)">
                                    @($"{account.AccountName} (Balance: {MoneyFormatter.Format(account.Balance)} RWF)")
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="int?"
                                   @bind-Value="_paymentMethodId"
                                   Label="Payment method"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Required="true"
                                   RequiredError="Select a payment method."
                                   Disabled="@(paymentMethods.Count == 0 || paymentOptionsError || isSaving)"
                                   Class="dialog-input">
                            @foreach (var method in paymentMethods)
                            {
                                <MudSelectItem T="int?" Value="@((int?)method.Id)">
                                    @method.PaymentMethodName
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }
                @if (paymentOptionsError)
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Warning" Class="mb-2">
                            Payment options could not be loaded. A replenishment without an initial payment can still be saved; retry before recording a payment.
                        </MudAlert>
                        <MudButton OnClick="LoadProductsAsync"
                                   Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Disabled="@isLoading">
                            Retry loading payment options
                        </MudButton>
                    </MudItem>
                }
                <MudItem xs="12">
                    <MudDatePicker @bind-Date="_replenishmentDate"
                                   Label="Replenishment Date"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   DateFormat="dd MMM yyyy"
                                   Required="true"
                                   Class="dialog-input" />
                </MudItem>
                <MudItem xs="12">
                    @if (isLoading)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                        <MudText Typo="Typo.caption">Loading products...</MudText>
                    }
                    else if (loadError)
                    {
                        <MudAlert Severity="Severity.Error" Class="mb-2">
                            Products could not be loaded. Retry before saving.
                        </MudAlert>
                        <MudButton OnClick="LoadProductsAsync"
                                   Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Disabled="@isLoading">
                            Retry loading products
                        </MudButton>
                    }
                    else if (products.Count == 0)
                    {
                        <MudAlert Severity="Severity.Warning" Class="mb-2">
                            No products exist yet. Add a product from the Products page before creating a replenishment.
                            If no product categories exist, create a category first.
                        </MudAlert>
                    }
                    else
                    {
                        <MudSelect T="int"
                                   @bind-Value="replenishment.ProductId"
                                   @bind-Value:after="OnProductChanged"
                                   For="@(() => replenishment.ProductId)"
                                   Label="Product"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Required="true"
                                   Disabled="@isLoading"
                                   Class="dialog-input">
                            @foreach (var product in products)
                            {
                                <MudSelectItem T="int" Value="@product.Id">
                                    @($"{product.ProductName} ({QuantityUnitFormatter.Format(product.Unit)})")
                                </MudSelectItem>
                            }
                        </MudSelect>
                        <ValidationMessage For="@(() => replenishment.ProductId)" />
                    }
                </MudItem>
            </MudGrid>

            <div class="d-flex justify-end mt-4">
                <MudButton Color="Color.Primary"
                           ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Save"
                           Disabled="@(!CanSave)"
                           Class="dialog-button-save">
                    Save
                </MudButton>
            </div>
            @if (!CanSave && !isLoading && !loadError && !isSaving && !string.IsNullOrWhiteSpace(SaveBlockedReason))
            {
                <MudAlert Severity="Severity.Info" Class="mt-2">@SaveBlockedReason</MudAlert>
            }
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel"
                   ButtonType="ButtonType.Button"
                   Variant="Variant.Text"
                   Color="Color.Default"
                   Disabled="@isSaving"
                   Class="dialog-button-cancel">
            Close
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private readonly AddReplenishmentDTO replenishment = new();
    private List<GetProductDTO> products = new();
    private List<GetAccountDTO> accounts = new();
    private List<GetPaymentMethordDTO> paymentMethods = new();
    private decimal _paidNow;
    private int? _accountId;
    private int? _paymentMethodId;
    private DateTime? _replenishmentDate = DateTime.Today;
    private bool isLoading;
    private bool isSaving;
    private bool loadError;
    private bool paymentOptionsError;
    private string SelectedProductUnit
    {
        get
        {
            var selectedProduct = products.FirstOrDefault(product => product.Id == replenishment.ProductId);
            return selectedProduct is null ? string.Empty : QuantityUnitFormatter.Format(selectedProduct.Unit);
        }
    }

    private bool CanSave =>
        !isLoading
        && !loadError
        && !isSaving
        && products.Count > 0
        && replenishment.ProductId > 0
        && replenishment.Unit is "kg" or "pcs"
        && replenishment.QuantityReplenished > 0
        && decimal.TryParse(replenishment.PurchasePrice, NumberStyles.Number, CultureInfo.InvariantCulture, out var purchasePrice)
        && purchasePrice > 0
        && _replenishmentDate.HasValue
        && _paidNow >= 0
        && _paidNow <= CalculatedTotal
        && (_paidNow == 0 || (!paymentOptionsError
            && accounts.Count > 0
            && paymentMethods.Count > 0
            && _accountId.HasValue
            && _paymentMethodId.HasValue));

    private string? SaveBlockedReason
    {
        get
        {
            if (products.Count == 0)
                return "Add or load a product before saving.";
            if (replenishment.ProductId <= 0)
                return "Select a product.";
            if (replenishment.Unit is not ("kg" or "pcs"))
                return "Select a product with a supported unit.";
            if (replenishment.QuantityReplenished <= 0)
                return "Enter a quantity greater than zero.";
            if (!decimal.TryParse(replenishment.PurchasePrice, NumberStyles.Number, CultureInfo.InvariantCulture, out var purchasePrice)
                || purchasePrice <= 0)
                return "Enter a purchase price greater than zero.";
            if (!_replenishmentDate.HasValue)
                return "Select a replenishment date.";
            if (_paidNow < 0 || _paidNow > CalculatedTotal)
                return "The amount paid now must be between zero and the replenishment total.";
            if (_paidNow > 0 && paymentOptionsError)
                return "Retry loading payment options or set the amount paid now to zero.";
            if (_paidNow > 0 && accounts.Count == 0)
                return "Add an active account before recording an initial supplier payment.";
            if (_paidNow > 0 && paymentMethods.Count == 0)
                return "Add an active payment method before recording an initial supplier payment.";
            if (_paidNow > 0 && !_accountId.HasValue)
                return "Select the account used for the supplier payment.";
            if (_paidNow > 0 && !_paymentMethodId.HasValue)
                return "Select a payment method.";
            return null;
        }
    }

    private decimal CalculatedTotal =>
        decimal.TryParse(replenishment.PurchasePrice, NumberStyles.Number, CultureInfo.InvariantCulture, out var purchasePrice)
            ? purchasePrice * replenishment.QuantityReplenished
            : 0m;

    protected override Task OnInitializedAsync() => LoadProductsAsync();

    private async Task LoadProductsAsync()
    {
        isLoading = true;
        loadError = false;

        try
        {
            products = await ProductService.GetAllProductAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load products for replenishment.");
            loadError = true;
            Snackbar.Add("Could not load products. Please retry.", Severity.Error);
        }
        try
        {
            accounts = (await AccountService.GetAllAccountAsync())
                .Where(account => string.Equals(account.Status, "Active", StringComparison.OrdinalIgnoreCase))
                .OrderBy(account => account.AccountName)
                .ToList();
            paymentMethods = (await PaymentMethodService.GetAllPaymentMethordAsync())
                .Where(method => string.Equals(method.Status, "Active", StringComparison.OrdinalIgnoreCase))
                .OrderBy(method => method.PaymentMethodName)
                .ToList();
            paymentOptionsError = false;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load account or payment method options for replenishment.");
            paymentOptionsError = true;
            Snackbar.Add("Could not load supplier payment options.", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private void OnProductChanged()
    {
        replenishment.Unit = products
            .FirstOrDefault(product => product.Id == replenishment.ProductId)?
            .Unit.Trim().ToLowerInvariant() ?? string.Empty;
    }

    private async Task SaveReplenishmentAsync()
    {
        if (!CanSave || _replenishmentDate is null)
            return;

        if (!decimal.TryParse(replenishment.PurchasePrice, NumberStyles.Number, CultureInfo.InvariantCulture, out var purchasePrice))
            return;

        isSaving = true;
        replenishment.ReplenishmentDate = _replenishmentDate.Value;
        replenishment.Unit = replenishment.Unit.Trim().ToLowerInvariant();
        var total = purchasePrice * replenishment.QuantityReplenished;
        replenishment.ReplenishmentAmount = total.ToString(CultureInfo.InvariantCulture);
        replenishment.TotalPurchasePrice = replenishment.ReplenishmentAmount;
        replenishment.PaidAmount = _paidNow;
        replenishment.AccountId = _paidNow > 0 ? _accountId : null;
        replenishment.PaymentMethodId = _paidNow > 0 ? _paymentMethodId : null;
        replenishment.DateAdded = DateTime.Now;
        replenishment.Status = "Active";

        try
        {
            await ReplenishmentService.AddReplenishmentAsync(replenishment);
            Snackbar.Add("Replenishment added successfully.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to add replenishment.");
            var message = exception is ArgumentException or InvalidOperationException or KeyNotFoundException
                ? exception.Message
                : "Could not add the replenishment. See the application log for details.";
            Snackbar.Add(message, Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }
}