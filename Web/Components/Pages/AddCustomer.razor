@using Application.DTOs
@using Application.Services.CustomerServices
@rendermode InteractiveServer
@inject ICustomerService CustomerService
@inject ISnackbar Snackbar
@inject ILogger<AddCustomer> Logger

<MudDialog>
    <TitleContent>Add Customer</TitleContent>
    <DialogContent>
        <EditForm Model="@customer" OnValidSubmit="SaveCustomerAsync">
            <DataAnnotationsValidator />
            <MudGrid>
                <MudItem xs="12">
                    <MudTextField @bind-Value="customer.CustomerName"
                                  Label="Customer Name"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                @* <MudItem xs="12">
                    <MudTextField @bind-Value="customer.Email"
                                  Label="Email"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" /> 
                 </MudItem> *@
                <MudItem xs="12">
                    <MudSelect T="string"
                               @bind-Value="customer.Sex"
                               For="@(() => customer.Sex)"
                               Label="Sex"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Required="true">
                        <MudSelectItem T="string" Value="@Male">Male</MudSelectItem>
                        <MudSelectItem T="string" Value="@Female">Female</MudSelectItem>
                    </MudSelect>
                    <ValidationMessage For="@(() => customer.Sex)" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="customer.PhoneNumber"
                                  For="@(() => customer.PhoneNumber)"
                                  Label="Phone Number"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  InputType="InputType.Telephone"
                                  MaxLength="10"
                                  Required="true"
                                  RequiredError="Phone number is required." />
                    <ValidationMessage For="@(() => customer.PhoneNumber)" />
                </MudItem>
            </MudGrid>

            <div class="d-flex justify-end mt-4">
                <MudButton Color="Color.Primary"
                           ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Disabled="@isSaving">SAVE</MudButton>
            </div>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel"
                   Variant="Variant.Text"
                   Disabled="@isSaving">
            Cancel
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const string Male = "Male";
    private const string Female = "Female";
    private bool isSaving;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private readonly AddCustomerDTO customer = new();

    private void Cancel() => MudDialog.Close(DialogResult.Cancel());

    private async Task SaveCustomerAsync()
    {
        if (isSaving)
            return;

        isSaving = true;
        customer.DateAdded = DateTime.Now;
        customer.Status = "Active";

        try
        {
            await CustomerService.AddCustomerAsync(customer);
            Snackbar.Add("Customer added successfully!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ArgumentException exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
        catch (InvalidOperationException exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to add customer.");
            Snackbar.Add("Could not add the customer. Please try again.", Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }
}
