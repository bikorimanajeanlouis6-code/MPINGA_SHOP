@page "/Products"
@using System.Globalization
@using Application.DTOs
@using Application.Services.ProductServices
@using Web.Formatting
@rendermode InteractiveServer
@inject IProductService ProductService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<Product> Logger

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudDataGrid T="GetProductDTO"
                 Items="@products"
                 SortMode="SortMode.Multiple"
                 Filterable="true"
                 QuickFilter="@QuickFilter"
                 Dense="true"
                 Hover="true"
                 Elevation="1">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Products</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="_searchString"
                          Placeholder="Search products"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="me-3" />
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@OpenAddProductAsync">
                Add Product
            </MudButton>
        </ToolBarContent>

        <Columns>
            <TemplateColumn Title="Reference">
                <CellTemplate>@EntityReferenceFormatter.Format(EntityReferenceType.Product, context.Item.Id)</CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="product => product.ProductName" Title="Product Name" />
            <PropertyColumn Property="product => product.ProductDescription" Title="Description" />
            <TemplateColumn Title="Price">
                <CellTemplate>
                    @{
                        var price = decimal.TryParse(context.Item.ProductPrice, NumberStyles.Number, CultureInfo.InvariantCulture, out var parsedPrice)
                            ? parsedPrice
                            : 0m;
                    }
                    @($"{MoneyFormatter.Format(price)} RWF")
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="product => product.ProductQuantity" Title="Quantity" />
            <PropertyColumn Property="product => product.ProductCategoryName" Title="Category" />
            <TemplateColumn Title="Date Added">
                <CellTemplate>
                    @context.Item.DateAdded.ToString("dd MMM yyyy")
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="product => product.UserAdded" Title="Added By" />
            <TemplateColumn Title="Actions">
                <CellTemplate>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Edit"
                               OnClick="@(() => OpenEditProductAsync(context.Item))">
                        Edit
                    </MudButton>
                </CellTemplate>
            </TemplateColumn>
            @* <TemplateColumn Title="Status">
                <CellTemplate>
                    <MudChip T="string"
                             Size="Size.Small"
                             Variant="Variant.Filled"
                             Color="@GetStatusColor(context.Item.Status)">
                        @context.Item.Status
                    </MudChip>
                </CellTemplate>
            </TemplateColumn> *@
        </Columns>

        <PagerContent>
            <MudDataGridPager T="GetProductDTO" />
        </PagerContent>
    </MudDataGrid>
</MudContainer>

@code {
    private string _searchString = string.Empty;
    private List<GetProductDTO> products = new();
    private bool isOpeningDialog;

    protected override async Task OnInitializedAsync()
    {
        await LoadProductsAsync();
    }

    private async Task LoadProductsAsync()
    {
        try
        {
            products = await ProductService.GetAllProductAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load products.");
            Snackbar.Add("Could not load products.", Severity.Error);
        }
    }

    private Func<GetProductDTO, bool> QuickFilter => product =>
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        return EntityReferenceFormatter.Format(EntityReferenceType.Product, product.Id).Contains(_searchString, StringComparison.OrdinalIgnoreCase)
            || product.ProductName.Contains(_searchString, StringComparison.OrdinalIgnoreCase)
            || (product.ProductDescription ?? string.Empty).Contains(_searchString, StringComparison.OrdinalIgnoreCase)
            || product.ProductCategoryName.Contains(_searchString, StringComparison.OrdinalIgnoreCase)
            || product.ProductPrice.ToString().Contains(_searchString, StringComparison.OrdinalIgnoreCase)
            || product.ProductQuantity.ToString().Contains(_searchString, StringComparison.OrdinalIgnoreCase)
            || product.DateAdded.ToString("dd MMM yyyy").Contains(_searchString, StringComparison.OrdinalIgnoreCase)
            || product.UserAdded.Contains(_searchString, StringComparison.OrdinalIgnoreCase)
            || product.Status.Contains(_searchString, StringComparison.OrdinalIgnoreCase);
    };

    private static Color GetStatusColor(string status) => status switch
    {
        "Active" => Color.Success,
        "Inactive" => Color.Error,
        _ => Color.Default
    };

    private async Task OpenAddProductAsync()
    {
        if (isOpeningDialog)
            return;

        isOpeningDialog = true;
        try
        {
            var dialog = await DialogService.ShowAsync<AddProduct>(
                "Add Product",
                new DialogOptions
                {
                    CloseButton = true,
                    CloseOnEscapeKey = true,
                    MaxWidth = MaxWidth.Small,
                    FullWidth = true
                });
            var result = await dialog.Result;

            if (result is not null && !result.Canceled)
                await LoadProductsAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to open the add-product dialog.");
            Snackbar.Add("Could not open the product form.", Severity.Error);
        }
        finally
        {
            isOpeningDialog = false;
        }
    }

    private async Task OpenEditProductAsync(GetProductDTO product)
    {
        if (isOpeningDialog)
            return;

        isOpeningDialog = true;
        try
        {
            var dialog = await DialogService.ShowAsync<EditProduct>(
                "Edit Product",
                new DialogParameters<EditProduct>
                {
                    { component => component.Product, product }
                },
                new DialogOptions
                {
                    CloseButton = true,
                    CloseOnEscapeKey = true,
                    MaxWidth = MaxWidth.Small,
                    FullWidth = true
                });
            var result = await dialog.Result;
            if (result is not null && !result.Canceled)
                await LoadProductsAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to open edit dialog for product {ProductId}.", product.Id);
            Snackbar.Add("Could not open the edit product form.", Severity.Error);
        }
        finally
        {
            isOpeningDialog = false;
        }
    }
}
