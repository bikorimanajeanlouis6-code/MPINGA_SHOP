@using System.Globalization
@using Application.DTOs
@using Application.Services.ProductCategoryServices
@using Application.Services.ProductServices
@inject IProductService ProductService
@inject IProductCategoryService ProductCategoryService
@inject ISnackbar Snackbar
@inject ILogger<AddProduct> Logger

<MudDialog Class="add-dialog">
    <TitleContent>Add Product</TitleContent>
    <DialogContent>
        <EditForm Model="@product" OnValidSubmit="SaveProductAsync">
            <DataAnnotationsValidator />
            <MudGrid>
                <MudItem xs="12">
                    <MudTextField @bind-Value="product.ProductName"
                                  For="@(() => product.ProductName)"
                                  Label="Product Name"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  AutoFocus="true"
                                  Class="dialog-input" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="product.ProductPrice"
                                  For="@(() => product.ProductPrice)"
                                  Label="Product Price"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  InputType="InputType.Number"
                                  Immediate="true"
                                  Class="dialog-input" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="product.ProductQuantity"
                                  For="@(() => product.ProductQuantity)"
                                  Label="Quantity"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  InputType="InputType.Number"
                                  Immediate="true"
                                  Class="dialog-input" />
                </MudItem>
                <MudItem xs="12">
                    @if (categoryLoadError)
                    {
                        <MudAlert Severity="Severity.Error" Class="mb-2">
                            Could not load product categories. Try again or close this dialog.
                        </MudAlert>
                        <MudButton OnClick="LoadCategoriesAsync"
                                   Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Disabled="@isLoadingCategories">
                            Retry loading categories
                        </MudButton>
                    }
                    else
                    {
                        <MudSelect T="int"
                                   @bind-Value="product.ProductCategoryId"
                                   For="@(() => product.ProductCategoryId)"
                                   Label="Product Category"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Required="true"
                                   Disabled="@isLoadingCategories"
                                   Class="dialog-input">
                            @foreach (var category in categories)
                            {
                                <MudSelectItem T="int" Value="@category.Id">
                                    @category.ProductCategoryName
                                </MudSelectItem>
                            }
                        </MudSelect>
                        <ValidationMessage For="@(() => product.ProductCategoryId)" />
                        @if (!isLoadingCategories && categories.Count == 0)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Warning">
                                No product categories exist yet. Add a category before saving a product.
                            </MudText>
                        }
                    }
                </MudItem>
            </MudGrid>

            <div class="d-flex justify-end mt-4">
                <MudButton Color="Color.Primary"
                           ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Save"
                           Disabled="@isSaving"
                           Class="dialog-button-save">
                    Save Product
                </MudButton>
            </div>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel"
                   ButtonType="ButtonType.Button"
                   Variant="Variant.Text"
                   Color="Color.Default"
                   Class="dialog-button-cancel">
            Close
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private readonly AddProductDTO product = new();
    private List<GetProductCategoryDTO> categories = new();
    private bool isSaving;
    private bool isLoadingCategories;
    private bool categoryLoadError;

    protected override Task OnInitializedAsync() => LoadCategoriesAsync();

    private async Task LoadCategoriesAsync()
    {
        isLoadingCategories = true;
        categoryLoadError = false;

        try
        {
            categories = await ProductCategoryService.GetAllProductCategoriesAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load product categories.");
            categoryLoadError = true;
            Snackbar.Add("Could not load product categories. Please retry.", Severity.Error);
        }
        finally
        {
            isLoadingCategories = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveProductAsync()
    {
        isSaving = true;
        product.DateAdded = DateTime.Now;
        product.Status = "Active";

        try
        {
            await ProductService.AddProductAsync(product);
            Snackbar.Add("Product added successfully.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to add product.");
            Snackbar.Add("Could not add the product.", Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }
}
