@page "/Expenses"
@using Application.DTOs
@using Application.Services.ExpenseServices
@using Web.Formatting
@rendermode InteractiveServer
 @using Microsoft.AspNetCore.Authorization
@attribute [Authorize]  
@inject IExpenseService ExpenseService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<Expenses> Logger

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudDataGrid T="GetExpenseDTO"
                 Items="@expenses"
                 SortMode="SortMode.Multiple"
                 Filterable="true"
                 QuickFilter="@QuickFilter"
                 Dense="true"
                 Hover="true"
                 Elevation="1">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Expenses</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="_searchString"
                          Placeholder="Search expenses"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense" />
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenAddExpenseAsync">
                Add Expense
            </MudButton>
        </ToolBarContent>

        <Columns>
            <TemplateColumn Title="Reference">
                <CellTemplate>@EntityReferenceFormatter.Format(EntityReferenceType.Expense, context.Item.Id)</CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="expense => expense.ExpenseName" Title="Expense Name" />
            <PropertyColumn Property="expense => expense.ExpenseTypeName" Title="Expense Type" />
            <PropertyColumn Property="expense => expense.AccountName" Title="Account" />
            <TemplateColumn Title="Expense Amount">
                <CellTemplate>
                    @($"{MoneyFormatter.Format(context.Item.ExpenseAmount)} RWF")
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Expense Date">
                <CellTemplate>
                    @context.Item.ExpenseDate.ToString("dd MMM yyyy")
                </CellTemplate>
            </TemplateColumn>
            @* <PropertyColumn Property="expense => expense.UserAdded" Title="User Added" /> *@
            <TemplateColumn Title="Details" Sortable="false" Filterable="false">
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   aria-label="@($"View details for expense {context.Item.Id}")"
                                   Disabled="@isOpeningDialog"
                                   OnClick="@(() => OpenExpenseDetailsAsync(context.Item))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>

        <PagerContent>
            <MudDataGridPager T="GetExpenseDTO" />
        </PagerContent>
    </MudDataGrid>
</MudContainer>

@code {
    private string _searchString = string.Empty;
    private List<GetExpenseDTO> expenses = new();
    private bool isOpeningDialog;

    protected override async Task OnInitializedAsync()
    {
        expenses = await ExpenseService.GetAllExpenseAsync();
    }

    private Func<GetExpenseDTO, bool> QuickFilter => expense =>
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        return EntityReferenceFormatter.Format(EntityReferenceType.Expense, expense.Id).Contains(_searchString, StringComparison.OrdinalIgnoreCase)
            || expense.ExpenseName.Contains(_searchString, StringComparison.OrdinalIgnoreCase)
            || expense.ExpenseTypeName.Contains(_searchString, StringComparison.OrdinalIgnoreCase)
            || expense.AccountName.Contains(_searchString, StringComparison.OrdinalIgnoreCase)
            || expense.ExpenseAmount.ToString().Contains(_searchString, StringComparison.OrdinalIgnoreCase)
            || expense.ExpenseDate.ToString("dd MMM yyyy").Contains(_searchString, StringComparison.OrdinalIgnoreCase)
            || expense.UserAdded.Contains(_searchString, StringComparison.OrdinalIgnoreCase);
    };

    private async Task OpenAddExpenseAsync()
    {
        if (isOpeningDialog)
            return;

        isOpeningDialog = true;
        try
        {
            var dialog = await DialogService.ShowAsync<AddExpense>(
                "Add Expense",
                new DialogOptions
                {
                    CloseButton = true,
                    CloseOnEscapeKey = true,
                    MaxWidth = MaxWidth.Small,
                    FullWidth = true
                });
            var result = await dialog.Result;

            if (result is not null && !result.Canceled)
                expenses = await ExpenseService.GetAllExpenseAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to open or complete the add-expense dialog.");
            Snackbar.Add("Could not open the expense form.", Severity.Error);
        }
        finally
        {
            isOpeningDialog = false;
        }
    }

    private async Task OpenExpenseDetailsAsync(GetExpenseDTO expense)
    {
        if (isOpeningDialog)
            return;

        isOpeningDialog = true;
        try
        {
            var dialog = await DialogService.ShowAsync<ExpenseDetails>(
                "Expense Details",
                new DialogParameters<ExpenseDetails>
                {
                    { component => component.ExpenseId, expense.Id }
                },
                new DialogOptions
                {
                    CloseButton = true,
                    CloseOnEscapeKey = true,
                    MaxWidth = MaxWidth.Small,
                    FullWidth = true
                });
            await dialog.Result;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to open details for expense {ExpenseId}.", expense.Id);
            Snackbar.Add("Could not open expense details.", Severity.Error);
        }
        finally
        {
            isOpeningDialog = false;
        }
    }
}
