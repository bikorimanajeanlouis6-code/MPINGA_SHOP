@page "/Replenishment"
@using System.Globalization
@using Web.Formatting
@using Application.Services.ReplenishmentServices
@rendermode InteractiveServer
@inject IReplenishmentService ReplenishmentService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<Repenishment> Logger

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h6">Replenishments</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="_searchString"
                          Placeholder="Search replenishments"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="me-3" />
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       Href="/ReplenishmentReport"
                       StartIcon="@Icons.Material.Filled.Assessment">
                Report
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@OpenAddReplenishmentAsync">
                Add Replenishment
            </MudButton>
        </MudStack>

        @if (loadError)
        {
            <MudAlert Severity="Severity.Error">
                Replenishments could not be loaded. Retry to try again.
                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           OnClick="@LoadReplenishmentsAsync"
                           Disabled="@isLoading">
                    Retry
                </MudButton>
            </MudAlert>
        }
        else if (isLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else
        {
            <MudDataGrid T="GetReplenishmentDTO"
                         Items="@replenishments"
                         SortMode="SortMode.Multiple"
                         Filterable="true"
                         QuickFilter="@QuickFilter"
                         Dense="true"
                         Hover="true"
                         Elevation="1">
                <Columns>
                    <TemplateColumn Title="Reference">
                        <CellTemplate>@EntityReferenceFormatter.Format(EntityReferenceType.Replenishment, context.Item.Id)</CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="replenishment => replenishment.ReplenishmentName" Title="Replenishment Name" />
                    <PropertyColumn Property="replenishment => replenishment.SupplierName" Title="Supplier Name" />
                    <PropertyColumn Property="replenishment => replenishment.SupplierPhone" Title="Supplier Phone" />
                    <TemplateColumn Title="Replenishment Date">
                        <CellTemplate>
                            @context.Item.ReplenishmentDate.ToString("dd MMM yyyy")
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Quantity Replenished">
                        <CellTemplate>
                            @context.Item.QuantityReplenished @QuantityUnitFormatter.Format(context.Item.Unit)
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Amount">
                        <CellTemplate>@FormatMoney(context.Item.ReplenishmentAmount)</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Details">
                        <CellTemplate>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Visibility"
                                       OnClick="@(() => OpenDetailsAsync(context.Item))">
                                View Details
                            </MudButton>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>

                <NoRecordsContent>
                    <MudText Class="pa-4" Color="Color.Secondary">
                        No replenishments have been added yet. Select Add Replenishment to create one.
                    </MudText>
                </NoRecordsContent>

                <PagerContent>
                    <MudDataGridPager T="GetReplenishmentDTO" />
                </PagerContent>
            </MudDataGrid>
        }
    </MudStack>
</MudContainer>

@code {
    private string _searchString = string.Empty;
    private List<GetReplenishmentDTO> replenishments = new();
    private bool _isOpeningAddDialog;
    private bool isLoading;
    private bool loadError;
    private bool _isOpeningDetailsDialog;

    private static string FormatMoney(string? amount)
    {
        if (!decimal.TryParse(amount, NumberStyles.Number, CultureInfo.InvariantCulture, out var value)
            && !decimal.TryParse(amount, NumberStyles.Number, CultureInfo.CurrentCulture, out value))
            return $"{amount} RWF";

        return $"{MoneyFormatter.Format(value)} RWF";
    }

    protected override Task OnInitializedAsync() => LoadReplenishmentsAsync();

    private async Task LoadReplenishmentsAsync()
    {
        isLoading = true;
        loadError = false;

        try
        {
            replenishments = await ReplenishmentService.GetAllReplenishmentsAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load replenishments.");
            loadError = true;
            Snackbar.Add("Could not load replenishments.", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private Func<GetReplenishmentDTO, bool> QuickFilter => replenishment =>
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        return EntityReferenceFormatter.Format(EntityReferenceType.Replenishment, replenishment.Id).Contains(_searchString, StringComparison.OrdinalIgnoreCase)
            || replenishment.ReplenishmentName.Contains(_searchString, StringComparison.OrdinalIgnoreCase)
            || replenishment.ReplenishmentAmount.Contains(_searchString, StringComparison.OrdinalIgnoreCase)
            || replenishment.SupplierName.Contains(_searchString, StringComparison.OrdinalIgnoreCase)
            || replenishment.SupplierPhone.Contains(_searchString, StringComparison.OrdinalIgnoreCase)
            || replenishment.ReplenishmentDate.ToString("dd MMM yyyy").Contains(_searchString, StringComparison.OrdinalIgnoreCase)
            || replenishment.QuantityReplenished.ToString().Contains(_searchString, StringComparison.OrdinalIgnoreCase)
            || replenishment.SellingPrice.Contains(_searchString, StringComparison.OrdinalIgnoreCase)
            || replenishment.PurchasePrice.Contains(_searchString, StringComparison.OrdinalIgnoreCase)
            || replenishment.TotalPurchasePrice.Contains(_searchString, StringComparison.OrdinalIgnoreCase)
            || replenishment.DateAdded.ToString("dd MMM yyyy").Contains(_searchString, StringComparison.OrdinalIgnoreCase);
    };

    private async Task OpenAddReplenishmentAsync()
    {
        if (_isOpeningAddDialog)
            return;

        _isOpeningAddDialog = true;
        try
        {
            var dialog = await DialogService.ShowAsync<AddReplenishment>(
                "Add Replenishment",
                new DialogOptions
                {
                    CloseButton = true,
                    CloseOnEscapeKey = true,
                    MaxWidth = MaxWidth.Small,
                    FullWidth = true
                });
            var result = await dialog.Result;

            if (result is not null && !result.Canceled)
                await LoadReplenishmentsAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to open or refresh the replenishment dialog.");
            Snackbar.Add("Could not open or refresh the replenishment form.", Severity.Error);
        }
        finally
        {
            _isOpeningAddDialog = false;
        }
    }

    private async Task OpenDetailsAsync(GetReplenishmentDTO replenishment)
    {
        if (_isOpeningDetailsDialog)
            return;

        _isOpeningDetailsDialog = true;
        try
        {
            var dialog = await DialogService.ShowAsync<ReplenishmentDetails>(
                "Replenishment Details",
                new DialogParameters<ReplenishmentDetails>
                {
                    { component => component.ReplenishmentId, replenishment.Id }
                },
                new DialogOptions
                {
                    CloseButton = true,
                    CloseOnEscapeKey = true,
                    MaxWidth = MaxWidth.Medium,
                    FullWidth = true
                });
            var result = await dialog.Result;
            if (result is not null && !result.Canceled)
                await LoadReplenishmentsAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to open replenishment details for {ReplenishmentId}.", replenishment.Id);
            Snackbar.Add("Could not open replenishment details.", Severity.Error);
        }
        finally
        {
            _isOpeningDetailsDialog = false;
        }
    }
}